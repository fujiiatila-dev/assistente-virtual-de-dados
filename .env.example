# Copie para .env apenas no ambiente local. Nunca versione o arquivo .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=0
OPENROUTER_FREE_DAILY_REQUEST_LIMIT=45
QUOTA_DB_PATH=runtime/quota.sqlite3
MAX_QUESTION_CHARS=2000
MAX_CONCURRENT_QUESTIONS=2
APP_REQUESTS_PER_MINUTE=5
DB_PATH=../anexo_desafio_1.db
MAX_SQL_FIX_ATTEMPTS=3
MAX_QUERY_BUDGET=6
# Opcional: executável Chrome/Chromium para exportação PNG com Kaleido 1.x.
# BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Compose no servidor: caminhos absolutos no host; nenhum valor secreto aqui.
# HOST_DB_PATH=/srv/data-assistant/data/anexo_desafio_1.db
# RUNTIME_DIR=/srv/data-assistant/runtime
# Token do Tunnel em runtime/tunnel.env (TUNNEL_TOKEN=...), somente no servidor.
# APP_IMAGE=ghcr.io/fujiiatila-dev/assistente-virtual-de-dados:sha-...
